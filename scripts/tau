# Runs TAU Commander with the Python interpreter installed next to this script.

self=$0
hops=0
while [ -L "$self" ]; do
  hops=$((hops + 1))
  # A symlink cycle would loop forever
  if [ "$hops" -gt 40 ]; then
    printf '%s\n' "tau: too many levels of symbolic links: $0" >&2
    exit 1
  fi
  target=$(readlink "$self")
  case $target in
  /*) self=$target ;;
  *) self=$(dirname "$self")/$target ;;
  esac
done
# With CDPATH set, cd could pick a different directory and print it.
dir=$(CDPATH='' cd -- "$(dirname "$self")" && pwd -P)

if [ ! -x "$dir/python" ]; then
  printf '%s\n' "tau: can't find the Python interpreter next to $dir/$(basename "$self"). Was the installation moved? Reinstall TAU Commander with 'uv tool install' or 'pipx install'." >&2
  exit 1
fi

__TAUCMDR_SCRIPT__="$dir/$(basename "$self")"
export __TAUCMDR_SCRIPT__
exec "$dir/python" -I -m taucmdr "$@"
